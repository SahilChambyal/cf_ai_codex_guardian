{
  "name": "cf-ai-codex-guardian",
  "version": "1.0.0",
  "private": true,
  "description": "Codex Guardian: an AI agent on Cloudflare that checks code changes against engineering standards (policy-as-code + Llama 3.3)",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types env.d.ts",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "typecheck": "tsc",
    "format": "oxfmt --write .",
    "lint": "oxlint src/",
    "check": "oxlint src/ && tsc && vitest run && tsx evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.293",
    "@cloudflare/ai-chat": "^0.9.3",
    "@cloudflare/kumo": "^2.6.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.17.4",
    "ai": "^6.0.197",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "workers-ai-provider": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.113.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
